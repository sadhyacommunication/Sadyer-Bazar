# Sadyer Bazar (সাধ্যের বাজার) — BUILD-TIME public configuration (copy to .env.local)
#
# ONLY values that are safe to expose in the browser belong here (NEXT_PUBLIC_*).
# SECRETS (service-role key, bKash/Nagad keys, Turnstile secret, ...) must NEVER be placed in
# any .env file and NEVER get a NEXT_PUBLIC_ prefix:
#   - local dev  -> .dev.vars        (see .dev.vars.example)
#   - production -> wrangler pages secret put <NAME>   (see docs/SECURITY_ROTATION_CHECKLIST.md)

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" (or sb_publishable_) key ONLY. Never the service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Cloudflare Turnstile public site key (test key below always passes; use the real one in production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
