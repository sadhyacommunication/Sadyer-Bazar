{
  "name": "sadyer-bazar",
  "version": "1.0.0",
  "private": true,
  "description": "Sadhyer Bazar (সাধ্যের বাজার) — গ্রামের পণ্য শহরে, আপনার ঘরে (Village Freshness in the City, at Your Home)",
  "scripts": {
    "dev": "node scripts/dev-runner.mjs",
    "dev:next": "next dev",
    "dev:api": "tsx scripts/dev-api-server.mjs",
    "build": "next build && node scripts/check-secrets.mjs",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:db": "node tests/db.harness.mjs",
    "test:edge": "tsx tests/middleware.test.mjs",
    "test:api": "tsx tests/api-routes.test.mjs",
    "test": "npm run test:db && npm run test:edge && npm run test:api"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.49.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
